{
  "name": "polymer-shop-qa-automation",
  "version": "1.0.0",
  "description": "QA Automation Framework for Polymer Shop — Playwright + TypeScript + POM",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:smoke": "playwright test --grep @smoke",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:slow": "SLOW_MO=500 playwright test --headed",
    "test:report": "playwright show-report test-execution-reports/html-report"
  },
  "keywords": ["automation", "testing", "playwright", "typescript", "pom"],
  "author": "Ravi Kiran",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
